# Favorites API Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# Server Configuration
# ============================================
# Port the server will listen on
PORT=8080

# ============================================
# MySQL Database Configuration
# ============================================
# MySQL Data Source Name
# Format: username:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
# Example: root:password@tcp(localhost:3306)/favorites_db?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=root:password@tcp(localhost:3306)/favorites_db?charset=utf8mb4&parseTime=True&loc=Local

# ============================================
# Redis Cache Configuration
# ============================================
# Redis server address (host:port)
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number (default: 0)
REDIS_DB=0

# ============================================
# New Relic APM Configuration (Optional)
# ============================================
# New Relic license key (get from https://newrelic.com)
# Leave empty to disable New Relic monitoring
NEW_RELIC_LICENSE_KEY=

# New Relic application name (appears in New Relic dashboard)
NEW_RELIC_APP_NAME=Favorites API

# ============================================
# JWT Authentication (Optional)
# ============================================
# JWT secret key for token signing
# If not set, a random key will be generated (not recommended for production)
JWT_SECRET=

# ============================================
# Development/Testing
# ============================================
# Set to "true" to enable debug logging
DEBUG=false

# Environment (development, staging, production)
ENVIRONMENT=development
